    "ui.settings.lyrics.interlude.precise.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم اكتشاف الفواصل فقط من نهاية مقطع YRC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo detecta instrumentales por el fin de sílaba YRC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détection des interludes uniquement par la fin de syllabe YRC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружение проигрышей только по концу слога YRC."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ phát hiện khoảng nhạc cụ dựa trên thời điểm kết thúc âm tiết YRC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅根据 YRC 音节结束时间检测器乐间奏。"
          }
        }
      }
    },
