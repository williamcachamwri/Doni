    "ui.settings.lyrics.motion_preset.apple_music_26.mobile_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم الخط والمسافات والألوان والشفافية والتتبع سطراً بسطر في iOS 26.6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la tipografía, el espaciado, el color, la opacidad y el seguimiento por línea de iOS 26.6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la police, l'espacement, les couleurs, l'opacité et le suivi ligne par ligne d'iOS 26.6."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует шрифт, интервалы, цвета, прозрачность и построчное следование iOS 26.6."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng font, khoảng cách, màu, độ mờ và nhịp đuổi từng dòng của iOS 26.6."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iOS 26.6 的字体、间距、颜色、透明度和逐行追赶节奏。"
          }
        }
      }
    },
    "ui.settings.lyrics.motion_preset.custom.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات مخصصة: الطباعة والتركيز وذيل السطر والالتحاق والارتداد والتخطيط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa parámetros personalizados: tipografía, foco, estela, alcance, rebote y diseño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramètres personnalisés : typographie, focus, traînée, rattrapage, rebond et mise en page."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свои параметры: типографика, фокус, шлейф строки, догон, отскок и раскладка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng các thông số tự chỉnh: typography, tiêu điểm, đuôi dòng, bắt kịp, nảy và layout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自定义参数：排版、焦点、行尾拖尾、追赶、弹动和布局。"
          }
        }
      }
    },
