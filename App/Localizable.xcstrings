          "stringUnit": {
            "state": "translated",
            "value": "Las comprobaciones automáticas solo avisan si hay una versión nueva; si fallan, no interrumpen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification automatique signale uniquement une nouvelle version ; un échec reste silencieux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автопроверка уведомляет только о новой версии; сбой проверки не мешает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查只在有新版本时提示；检查失败不会打断你。"
          }
        }
      }
    },
