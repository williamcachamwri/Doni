    "Tắt thì Doni chỉ hiện lời đã có trên máy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف لن يعرض Doni إلا الكلمات الموجودة على الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo desactivas, Doni solo mostrará las letras que ya estén en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, Doni n’affiche que les paroles déjà présentes sur l’appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить, Doni покажет только текст, уже сохранённый на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后 Doni 只显示设备上已有的歌词。"
          }
        }
      }
    },
