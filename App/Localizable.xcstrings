    "Bỏ một kênh khỏi danh sách ngừng đưa bài của nó vào thư viện; nhạc đã tải vẫn còn trên máy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة قناة من القائمة توقف إضافة أغانيها إلى المكتبة؛ الموسيقى المحمّلة تبقى على الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar un canal de la lista deja de añadir sus canciones a la biblioteca; la música descargada se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer un canal de la liste cesse d’ajouter ses titres à la bibliothèque ; la musique téléchargée reste sur l’appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление канала из списка прекращает добавление его песен в библиотеку; загруженная музыка останется на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将频道移出列表会停止把它的歌曲加入资料库；已下载的音乐仍留在设备上。"
          }
        }
      }
    },
