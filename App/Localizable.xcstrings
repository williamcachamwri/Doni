      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة بيانات أنشأها TDLib — لا يمكن حذفها أثناء تسجيل الدخول"
          }
        },
        "es": {
          "stringUnit": {
