    "Thêm một bài từ bất kỳ danh sách nào bằng dấu ⋯ cạnh bài đó.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أغنية عبر علامة ⋯ بجانب أي أغنية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una canción desde el ⋯ que aparece junto a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un titre depuis le ⋯ affiché à côté de lui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте песню через ⋯ рядом с ней в любом списке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从任意歌曲旁的 ⋯ 添加一首歌。"
          }
        }
      }
    },
    "Thêm một bài vào danh sách từ bất kỳ đâu.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أغنية إلى قائمة من أي مكان."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una canción a una lista desde cualquier pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un titre à une liste depuis n’importe où."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте трек в плейлист из любого раздела."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何地方把一首歌加入歌单。"
          }
        }
      }
    },
    "Thêm một kênh Telegram để Doni biết trong đó có bài nào.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف قناة تيليجرام ليعرف دوني ما فيها من أغاني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un canal de Telegram para que Doni sepa qué canciones hay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une chaîne Telegram pour que Doni sache quels titres s'y trouvent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте канал Telegram, чтобы Doni знал, какие там песни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个 Telegram 频道，Doni 就能知道里面有哪些歌曲。"
          }
        }
      }
    },
