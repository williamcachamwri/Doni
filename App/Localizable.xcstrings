    "ui.settings.lyrics.interlude.automatic.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم توقيت YRC الدقيق عند توفره، ويقدّر نهاية السطر حسب طول النص في ملفات LRC العادية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el timing YRC exacto cuando existe y estima el final de línea por longitud de texto en LRC normales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le calage YRC exact quand il existe et estime la fin de ligne selon la longueur du texte pour les LRC ordinaires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le timing YRC précis quand il existe et estime la fin de ligne selon la longueur du texte pour les LRC simples."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng timing YRC chính xác khi có, và ước lượng thời điểm hết dòng theo độ dài chữ với lời LRC thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在有精确 YRC 时间时使用精确时间，并对普通 LRC 按文字长度估算行尾时间。"
          }
        }
      }
    },
    "ui.settings.lyrics.interlude.hidden.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم إدراج مقدمات أو فواصل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se insertan intros ni pausas instrumentales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune intro ni interlude n'est inséré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вступления и проигрыши не вставляются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không chèn khoảng mở đầu hay gián đoạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不插入前奏或间奏空白。"
          }
        }
      }
    },
    "ui.settings.lyrics.interlude.precise": {
      "extractionState": "manual",
      "localizations": {
