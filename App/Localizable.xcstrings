    "Doni chỉ lấy những bài audio, dù nguồn là kênh, nhóm, người dùng hay bot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يأخذ دوني إلا الملفات الصوتية، سواء من قناة أو مجموعة أو مستخدم أو بوت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni solo toma audios, ya sea de canales, grupos, usuarios o bots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni ne retient que les audios, qu’ils viennent d’une chaîne, d’un groupe, d’un utilisateur ou d’un bot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni берёт только аудио — из каналов, групп, пользователей и ботов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni 只提取音频歌曲，无论来源是频道、群组、用户还是机器人。"
          }
        }
      }
    },
    "Doni giữ trên máy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظه دوني على الجهاز"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni lo guarda en el dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni le garde sur l’appareil"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni сохраняет на устройстве"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni 在本机保留"
          }
        }
      }
    },
    "Doni là ứng dụng không chính thức, không liên kết và không được Telegram hay bất kỳ hãng nhạc nào uỷ quyền. Nó chỉ mở những file đang nằm trong tài khoản Telegram của bạn.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni عميل غير رسمي وغير تابع لتيليجرام أو لأي شركة موسيقى وغير مفوَّض منها. لا يفتح إلا الملفات الموجودة في حسابك على تيليجرام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni es un cliente no oficial y no está afiliado ni autorizado por Telegram ni por ninguna compañía musical. Solo abre los archivos que ya están en tu cuenta de Telegram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni est un client non officiel, sans lien ni autorisation de Telegram ou de toute société de musique. Il n’ouvre que les fichiers déjà présents dans votre compte Telegram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni — неофициальный клиент, не связанный с Telegram или музыкальными компаниями и не авторизован ими. Он открывает только файлы из вашего аккаунта Telegram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni 是非官方第三方客户端，与 Telegram 或任何音乐公司没有隶属关系，也未获其授权。它只打开你 Telegram 账号里已有的文件。"
          }
        }
      }
    },
    "Doni lấy nhạc từ các kênh Telegram bạn thêm vào.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجلب Doni الموسيقى من قنوات تيليجرام التي تضيفها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni obtiene la música de los canales de Telegram que añadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni puise la musique dans les chaînes Telegram que vous ajoutez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni берёт музыку из добавленных вами каналов Telegram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni 从你添加的 Telegram 频道获取音乐。"
          }
        }
      }
    },
    "Doni sẽ mở lại bằng %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُعاد فتح دوني بـ %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni se abrirá de nuevo en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni se rouvrira en %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni откроется заново на %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni 将以 %@ 重新打开。"
          }
        }
      }
    },
    "Doni sẽ tải lại ảnh bìa và ảnh kênh khi cần. Ảnh bạn tự chọn cho một danh sách không nằm trong số này.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعيد دوني تنزيل الأغلفة وصور القنوات عند الحاجة، أما الصور التي تختارها لقائمة فهي ليست كذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni volverá a descargar portadas e imágenes de canal cuando haga falta; las que elijas para una lista no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni retéléchargera pochettes et images de chaîne au besoin ; celles choisies pour une liste non."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni снова загрузит обложки и аватары каналов при необходимости; выбранные вами для плейлиста — нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni 会在需要时重新下载封面和频道头像。你为歌单自选的图片不在此列。"
          }
        }
      }
    },
    "Doni viết bằng SwiftUI thuần và phát nhạc từ các kênh Telegram cùng Saved Messages của chính bạn, qua TDLib. Không có máy chủ nào của riêng app, không có tài khoản nào ngoài tài khoản Telegram của bạn, và không có gì được gửi đi ngoài Telegram và các nguồn lời bài hát.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni مكتوب بـSwiftUI الأصلي ويشغّل الموسيقى من قنواتك على تيليجرام و«الرسائل المحفوظة» عبر TDLib. لا خوادم خاصة ولا حسابات غير حسابك؛ ولا يخرج شيء سوى إلى تيليجرام ومصادر الكلمات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni está escrito en SwiftUI nativo y reproduce la música de tus canales de Telegram y de Guardados mediante TDLib. No hay servidores propios ni cuentas aparte de la de Telegram; nada sale del teléfono salvo Telegram y las fuentes de letras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni est écrit en SwiftUI natif et lit la musique de vos chaînes Telegram et de Messages enregistrés via TDLib. Aucun serveur propre, aucun compte autre que le vôtre ; rien ne sort vers Telegram et les sources de paroles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni написан на нативном SwiftUI и играет музыку из ваших Telegram-каналов и Saved Messages через TDLib. Своих серверов нет, аккаунтов кроме Telegram тоже; наружу уходят только запросы к Telegram и к источникам текстов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni 使用原生 SwiftUI 构建，通过 TDLib 播放你自己 Telegram 频道与 Saved Messages 中的音乐。它没有自己的服务器，也没有除你 Telegram 账号之外的账号；除了 Telegram 和歌词来源，不会向外发送任何内容。"
          }
        }
      }
    },
    "Doni đổi ngôn ngữ khi bạn mở lại app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيغيّر دوني اللغة عند إعادة فتح التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni cambiará de idioma al abrirse de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni changera de langue au prochain lancement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni сменит язык при следующем запуске."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开 Doni 后语言生效。"
          }
        }
      }
    },
    "Doni đứng trên vai TDLib, OpenSSL và mã của MeloX; giấy phép của từng thứ được ghi ở đây.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد Doni على TDLib وOpenSSL وشفرة MeloX؛ وتراخيص كلٍّ منها مبيّنة هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni se apoya en TDLib, OpenSSL y el código de MeloX; aquí están sus licencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni s’appuie sur TDLib, OpenSSL et le code de MeloX ; leurs licences sont listées ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni опирается на TDLib, OpenSSL и код MeloX; лицензии каждого проекта перечислены здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doni 基于 TDLib、OpenSSL 和 MeloX 的代码；每一项的许可都列在这里。"
          }
        }
      }
    },
    "Dành cho bạn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vous"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вас"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你推荐"
          }
        }
      }
    },
    "Dán một link t.me hoặc chọn từ danh sách trò chuyện.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رابط t.me أو اختر من قائمة المحادثات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un enlace t.me o elige uno de la lista de chats."
          }
