    "Chưa có kết nối Telegram, nên không thể báo cho TDLib biết các bài này đã không còn trên máy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بتيليجرام، لذا لا يمكن إخبار TDLib بأن هذه الأغاني لم تعد على الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conexión con Telegram, así que no se puede avisar a TDLib de que estas canciones ya no están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram n’est pas connecté, impossible d’en avertir TDLib que ces titres ont disparu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет соединения с Telegram, поэтому TDLib не узнать, что этих треков больше нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未连接 Telegram，因此无法告知 TDLib 这些歌曲已不在本机。"
          }
        }
      }
    },
