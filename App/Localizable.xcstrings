    },
    "Nhạc bạn tự đưa lên Telegram": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موسيقى رفعتها إلى تيليجرام"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Música que subiste a Telegram"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Musique que vous avez téléversée sur Telegram"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Музыка, которую вы загрузили в Telegram"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你上传到 Telegram 的音乐"
          }
        }
      }
    },
    "Nhạc tải từ Telegram về máy sẽ bị xoá. Danh sách và bài yêu thích vẫn còn, và bài nào cũng tải lại được. File bạn thêm vào ở Cloud Music không bị đụng tới.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف الموسيقى المنزّلة من تيليجرام. القوائم والمفضلة تبقى، ويمكن تنزيل أي أغنية مجددًا. أما الملفات التي أضفتها في موسيقى السحابة فلن تُمس."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrará la música descargada de Telegram. Listas y favoritas se conservan y cualquier canción puede volver a descargarse. Los archivos que añadiste en Cloud Music no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les musiques téléchargées depuis Telegram seront supprimées. Listes et favoris sont conservés, et tout titre peut être re-téléchargé. Les fichiers ajoutés dans Cloud Music ne sont pas touchés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет удалена музыка, скачанная из Telegram. Плейлисты и избранное останутся, любой трек можно скачать заново. Файлы, добавленные в Cloud Music, не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Telegram 下载到本机的音乐会被删除。歌单和收藏保留，任何歌曲都能重新下载。你在 Cloud Music 添加的文件不受影响。"
          }
        }
      }
    },
    "Nhấn + ở trên, hoặc nhấn giữ một bài trong Thư viện rồi chọn Danh sách mới.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + في الأعلى، أو اضغط مطولاً على أغنية في المكتبة ثم اختر قائمة جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el + de arriba o mantén pulsada una canción en Biblioteca y elige Nueva lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le + en haut, ou restez appuyé sur un titre de la Bibliothèque puis choisissez Nouvelle liste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите + сверху или долгое нажатие на трек в Библиотеке → «Новый плейлист»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点上面的 +，或在资料库中长按一首歌曲并选择“新建歌单”。"
          }
        }
      }
    },
    "Nhấn giữ một bài trong Thư viện rồi chọn Yêu thích. Giữ cả bài, hoặc giữ lại đoạn bạn muốn nghe — đoạn đã giữ sẽ lặp lại khi phát.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولاً على أغنية في المكتبة ثم اختر المفضلة. احفظ الأغنية كاملة أو المقطع الذي تريد سماعه — وسيُعاد المقطع المحفوظ عند التشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una canción en Biblioteca y elige Favoritos. Guarda entera o solo el fragmento que quieras oír — se repetirá al reproducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appui long sur un titre de la Bibliothèque puis Favoris. Gardez le titre entier ou seulement la section voulue — elle se répétera à la lecture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долгое нажатие на трек в Библиотеке → Избранное. Сохранить целиком или только нужный отрезок — он будет повторяться при воспроизведении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在资料库中长按歌曲并选择“收藏”。可保留整首，或只保留你想听的片段 — 已保存的片段会在播放时循环。"
          }
        }
      }
    },
    "Nhấn giữ một bài trong Thư viện rồi chọn một danh sách.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولاً على أغنية في المكتبة ثم اختر قائمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una canción en Biblioteca y elige una lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appui long sur un titre de la Bibliothèque puis choisissez une liste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долгое нажатие на трек в Библиотеке → выберите плейлист."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在资料库中长按歌曲并选择一个歌单。"
          }
        }
      }
    },
    "Nhập câu bắt đầu bằng “%@” mà chúng tôi đã gửi cho %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الجملة التي تبدأ بـ «%@» وأرسلناها إلى %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la frase que empieza por «%@» que enviamos a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la phrase commençant par « %@ » que nous avons envoyée à %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите фразу, начинающуюся с «%@», которую мы отправили на %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入我们以“%@”开头发给 %@ 的句子。"
          }
        }
      }
    },
