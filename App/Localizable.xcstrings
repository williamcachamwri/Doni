    "Lời bài hát": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمات"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroles"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст песни"
          }
        },
        "zh-Hans": {
